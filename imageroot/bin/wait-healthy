#!/usr/bin/env python3

"""Wait for mail-toolbox-app /api/health readiness and dump Podman container logs on failure."""

from __future__ import annotations

import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path


def _resolve_web_port(state_dir: Path) -> str:
    port = os.environ.get("WEB_TCP_PORT", "").strip()
    if port:
        return port

    env_file = state_dir / "environment"
    if env_file.is_file():
        for raw_line in env_file.read_text(encoding="utf-8", errors="replace").splitlines():
            line = raw_line.strip()
            if line.startswith("WEB_TCP_PORT="):
                return line.split("=", 1)[1].strip().strip("\"'")
    return ""


def _is_container_stopped() -> bool:
    try:
        res = subprocess.run(
            ["podman", "inspect", "-f", "{{.State.Running}}", "mail-toolbox-app"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if res.returncode == 0 and res.stdout.strip().lower() == "false":
            return True
    except Exception:
        pass
    return False


def _dump_container_logs() -> None:
    print("mail-toolbox-app failed health check; last 60 container log lines:", file=sys.stderr)
    try:
        logs = subprocess.run(
            ["podman", "logs", "--tail", "60", "mail-toolbox-app"],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
        combined = (logs.stdout or "") + (logs.stderr or "")
        if combined.strip():
            print(combined.rstrip(), file=sys.stderr)
        else:
            print("(no container logs available)", file=sys.stderr)
    except Exception as exc:
        print(f"(failed to retrieve podman logs: {exc})", file=sys.stderr)


def main() -> int:
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    web_port = _resolve_web_port(state_dir)
    if not web_port:
        print("Error: WEB_TCP_PORT is not set in environment", file=sys.stderr)
        return 1

    health_url = f"http://127.0.0.1:{web_port}/api/health"
    for attempt in range(1, 46):
        try:
            with urllib.request.urlopen(health_url, timeout=2) as resp:
                if resp.status == 200:
                    return 0
        except Exception:
            pass

        if attempt >= 3 and _is_container_stopped():
            print(
                f"mail-toolbox-app exited prematurely (attempt {attempt}/45)",
                file=sys.stderr,
            )
            break

        time.sleep(1)

    print(f"Timed out waiting for {health_url} after 45s", file=sys.stderr)
    _dump_container_logs()
    return 1


if __name__ == "__main__":
    sys.exit(main())
