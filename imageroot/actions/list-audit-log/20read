#!/usr/bin/env python3

"""Retrieve recent vacation & forwarding audit log entries via GET /api/internal/audit."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


def main() -> int:
    limit: int | None = None
    try:
        raw_input = sys.stdin.read().strip()
        if raw_input:
            parsed = json.loads(raw_input)
            if isinstance(parsed, dict) and parsed.get("limit"):
                limit = int(parsed["limit"])
    except Exception:
        limit = None

    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()

    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not web_tcp_port or not token_path.is_file():
        json.dump({"entries": []}, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    base_url = f"http://127.0.0.1:{web_tcp_port}/api/internal/audit"
    url = f"{base_url}?limit={limit}" if limit else base_url

    req = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to retrieve audit log: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
