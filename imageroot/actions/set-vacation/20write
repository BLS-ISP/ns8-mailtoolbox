#!/usr/bin/env python3

"""Apply or disable central mailbox vacation & forwarding rule via backend internal API."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


def main() -> int:
    payload = json.load(sys.stdin)
    user = str(payload.get("user", "")).strip()
    if not user:
        print("Missing required field: user", file=sys.stderr)
        return 2

    if not payload.get("updated_by"):
        payload["updated_by"] = "cockpit-admin"

    web_tcp_port = os.environ["WEB_TCP_PORT"]
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token = (state_dir / "config" / "internal.token").read_text(encoding="utf-8").strip()

    encoded_user = urllib.parse.quote(user, safe="")
    url = f"http://127.0.0.1:{web_tcp_port}/api/internal/mailboxes/{encoded_user}/vacation"
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="PUT",
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to update mailbox vacation rule: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
