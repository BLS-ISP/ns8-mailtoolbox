#!/usr/bin/env python3

"""Synchronize mailbox cache with smart 5-minute TTL (unless force_refresh) and proxy GET /api/internal/mailboxes."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path


EMPTY_RESPONSE = {
    "mailboxes": [],
    "summary": {
        "total": 0,
        "central_vacation_active": 0,
        "sogo_vacation_active": 0,
        "forwards_active": 0,
    },
}


def _read_force_refresh_flag() -> bool:
    try:
        raw = sys.stdin.read().strip()
        if raw:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                return bool(parsed.get("force_refresh", False))
    except Exception:
        pass
    return False


def main() -> int:
    force_refresh = _read_force_refresh_flag()
    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()

    if not mail_module_uuid or not web_tcp_port:
        json.dump(EMPTY_RESPONSE, sys.stdout)
        return 0

    sync_cmd = (
        ["sync-mailboxes-cache", "--skip-imapsync"]
        if force_refresh
        else ["sync-mailboxes-cache", "--min-age", "300", "--skip-imapsync"]
    )
    try:
        subprocess.run(
            sync_cmd,
            stdout=subprocess.DEVNULL,
            timeout=15,
            check=False,
        )
    except Exception as exc:
        print(f"Warning: sync-mailboxes-cache skipped: {exc}", file=sys.stderr)

    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"
    if not token_path.is_file():
        json.dump(EMPTY_RESPONSE, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/mailboxes",
        headers={
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            body = resp.read().decode("utf-8")
            sys.stdout.write(body)
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to query mail-toolbox backend: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
