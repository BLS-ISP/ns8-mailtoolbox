{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "save-connector input",
  "$id": "http://nethserver.org/json-schema/task/input/mail-toolbox/save-connector",
  "description": "Create or update an external POP3/IMAP mail connector",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "target_user",
    "target_email",
    "protocol",
    "host",
    "port",
    "remote_user"
  ],
  "properties": {
    "id": {
      "type": ["integer", "null"]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "target_user": {
      "type": "string",
      "minLength": 1
    },
    "target_email": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string",
      "enum": ["imaps", "imap", "pop3s", "pop3"]
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "use_ssl": {
      "type": "boolean"
    },
    "remote_user": {
      "type": "string",
      "minLength": 1
    },
    "remote_password": {
      "type": ["string", "null"]
    },
    "interval_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "leave_on_server": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
