#!/usr/bin/env python3

"""Render live signature preview for a mailbox user via POST /api/internal/signatures/preview."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


EMPTY_PREVIEW = {
    "matched_rule_name": "",
    "attributes": {},
    "rendered_html": "",
    "rendered_text": "",
}


def main() -> int:
    raw = sys.stdin.read().strip()
    payload = json.loads(raw) if raw else {}

    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not web_tcp_port or not token_path.is_file():
        json.dump(EMPTY_PREVIEW, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/signatures/preview",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to preview signature: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
