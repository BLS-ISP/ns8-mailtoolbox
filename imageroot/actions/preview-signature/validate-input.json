{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "preview-signature input",
  "$id": "http://nethserver.org/json-schema/task/input/mail-toolbox/preview-signature",
  "description": "Render live HTML and Plaintext signature preview for a real AD/LDAP mailbox user",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "user"
  ],
  "properties": {
    "user": {
      "type": "string",
      "minLength": 1
    },
    "sender_email": {
      "type": ["string", "null"]
    },
    "html_template": {
      "type": ["string", "null"]
    },
    "text_template": {
      "type": ["string", "null"]
    },
    "auto_plain_from_html": {
      "type": "boolean"
    }
  }
}
