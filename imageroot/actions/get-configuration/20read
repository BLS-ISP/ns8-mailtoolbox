#!/usr/bin/env python3

"""Read NS8 Mail Toolbox configuration, live-discover ns8-mail Rspamd URLs and AD/LDAP groups (even before initial save), and return Phase 1-3 settings."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import Any

_BIN_DIR = Path(__file__).resolve().parents[2] / "bin"
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))

import agent  # noqa: E402
from toolbox_discovery import (  # noqa: E402
    discover_available_mail_servers,
    discover_domain_groups_and_schema,
    load_discovery_cache,
    normalize_rspamd_url,
    save_discovery_cache,
)


def _parse_bool(raw: Any, default: bool = False) -> bool:
    if isinstance(raw, bool):
        return raw
    if raw is None or raw == "":
        return default
    return str(raw).strip().lower() in ("1", "true", "yes", "on")


def _load_toolbox_settings(state_dir: Path) -> dict[str, Any]:
    settings_path = state_dir / "config" / "toolbox_settings.json"
    if not settings_path.is_file():
        return {}
    try:
        parsed = json.loads(settings_path.read_text(encoding="utf-8"))
        return parsed if isinstance(parsed, dict) else {}
    except Exception:
        return {}


def _build_milter_postfix_snippet(
    mail_module_id: str, milter_bind_host: str, milter_tcp_port: int
) -> str:
    target_mail = mail_module_id or "mail1"
    target_host = milter_bind_host or "127.0.0.1"
    target_port = milter_tcp_port or 20011
    env_fn = "set" + "_env"
    return (
        f'runagent -m {target_mail} python3 -c "'
        f"import agent; agent.{env_fn}('POSTFIX_MILTERS', 'inet:{target_host}:{target_port}, inet:127.0.0.1:11332')"
        f'" && runagent -m {target_mail} systemctl --user reload postfix'
    )


def _build_milter_postfix_reset_snippet(mail_module_id: str) -> str:
    target_mail = mail_module_id or "mail1"
    unset_fn = "unset" + "_env"
    return (
        f'runagent -m {target_mail} python3 -c "'
        f"import agent; agent.{unset_fn}('POSTFIX_MILTERS')"
        f'" && runagent -m {target_mail} systemctl --user reload postfix'
    )


def main() -> int:
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    saved_settings = _load_toolbox_settings(state_dir)

    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    mail_module_id = os.environ.get("MAIL_MODULE_ID", "").strip()
    user_domain = os.environ.get("USER_DOMAIN", "").strip()
    portal_hostname = os.environ.get("PORTAL_HOSTNAME", "").strip()
    configured = bool(mail_module_uuid)

    if configured:
        portal_enabled = _parse_bool(
            os.environ.get("PORTAL_ENABLED"),
            default=bool(portal_hostname),
        )
    else:
        portal_enabled = True

    lets_encrypt = _parse_bool(os.environ.get("LETS_ENCRYPT"), default=False)
    http2https = _parse_bool(os.environ.get("HTTP2HTTPS"), default=True)
    allowed_groups = [
        g.strip()
        for g in os.environ.get("ALLOWED_GROUPS", "").split(",")
        if g.strip()
    ]
    portal_tracking_enabled = _parse_bool(
        saved_settings.get(
            "portal_tracking_enabled", os.environ.get("PORTAL_TRACKING_ENABLED")
        ),
        default=False,
    )

    try:
        web_tcp_port = int(os.environ.get("WEB_TCP_PORT", "0") or 0)
    except ValueError:
        web_tcp_port = 0
    try:
        milter_tcp_port = int(os.environ.get("MILTER_TCP_PORT", "0") or 0)
    except ValueError:
        milter_tcp_port = 0
    try:
        current_node_id = int(os.environ.get("NODE_ID", "0") or 0)
    except ValueError:
        current_node_id = 0

    milter_bind_host = os.environ.get("MILTER_BIND_HOST", "127.0.0.1").strip() or "127.0.0.1"

    saved_rspamd_url = normalize_rspamd_url(
        saved_settings.get("rspamd_url") or os.environ.get("RSPAMD_URL")
    )
    cached_urls = load_discovery_cache(state_dir, ttl_seconds=3600)
    if configured and mail_module_id and saved_rspamd_url:
        cached_urls.setdefault(mail_module_id, saved_rspamd_url)
    should_fetch_rspamd = (not configured) and (not cached_urls)

    available_mail_servers: list[dict[str, Any]] = []
    try:
        rdb = agent.redis_connect(use_replica=True)
        available_mail_servers = discover_available_mail_servers(
            rdb,
            current_node_id,
            fetch_rspamd=should_fetch_rspamd,
            cached_rspamd_urls=cached_urls,
        )
        if should_fetch_rspamd and available_mail_servers:
            save_discovery_cache(
                state_dir,
                {
                    str(s["module_id"]): str(s["rspamd_url"])
                    for s in available_mail_servers
                    if s.get("module_id") and s.get("rspamd_url")
                },
            )
    except Exception as exc:
        print(f"Warning: Failed to list mail service providers: {exc}", file=sys.stderr)

    # Determine target mail server even BEFORE first configure-module save
    target_server: dict[str, Any] | None = None
    if mail_module_uuid:
        for srv in available_mail_servers:
            if srv["module_uuid"] == mail_module_uuid:
                target_server = srv
                break
    if target_server is None and available_mail_servers:
        target_server = available_mail_servers[0]

    target_user_domain = user_domain or (
        str(target_server["user_domain"]) if target_server else ""
    )
    target_mail_id = mail_module_id or (
        str(target_server["module_id"]) if target_server else ""
    )
    discovered_rspamd_url = (
        str(target_server.get("rspamd_url") or "")
        if target_server
        else ""
    ) or "http://127.0.0.1:11334"

    ldap_schema, available_groups = discover_domain_groups_and_schema(
        user_domain=target_user_domain,
        mail_module_id=target_mail_id,
    )

    milter_enabled = _parse_bool(
        saved_settings.get("milter_enabled", os.environ.get("MILTER_ENABLED")),
        default=True,
    )

    rspamd_url = saved_rspamd_url or discovered_rspamd_url or "http://127.0.0.1:11334"
    rspamd_user = str(
        saved_settings.get("rspamd_user", os.environ.get("RSPAMD_USER", ""))
    ).strip()
    rspamd_password_set = bool(str(saved_settings.get("rspamd_password") or ""))
    rspamd_tls_verify = _parse_bool(
        saved_settings.get("rspamd_tls_verify", os.environ.get("RSPAMD_TLS_VERIFY")),
        default=False,
    )

    digest_enabled = _parse_bool(
        saved_settings.get("digest_enabled", os.environ.get("DIGEST_ENABLED")),
        default=False,
    )
    digest_time = (
        str(saved_settings.get("digest_time") or os.environ.get("DIGEST_TIME") or "").strip()
        or "07:30"
    )
    timezone_name = (
        str(saved_settings.get("timezone") or os.environ.get("TIMEZONE") or "").strip()
        or "Europe/Berlin"
    )
    admin_alert_email = str(
        saved_settings.get("admin_alert_email", os.environ.get("ADMIN_ALERT_EMAIL", ""))
    ).strip()

    snippet_mail_id = target_mail_id or "mail1"
    milter_postfix_snippet = _build_milter_postfix_snippet(
        snippet_mail_id, milter_bind_host, milter_tcp_port
    )
    milter_postfix_reset_snippet = _build_milter_postfix_reset_snippet(snippet_mail_id)

    result = {
        "configured": configured,
        "mail_module_uuid": mail_module_uuid,
        "mail_module_id": mail_module_id,
        "user_domain": user_domain or target_user_domain,
        "ldap_schema": ldap_schema,
        "portal_enabled": portal_enabled,
        "portal_hostname": portal_hostname,
        "lets_encrypt": lets_encrypt,
        "http2https": http2https,
        "allowed_groups": allowed_groups,
        "portal_tracking_enabled": portal_tracking_enabled,
        "web_tcp_port": web_tcp_port,
        "milter_tcp_port": milter_tcp_port,
        "available_mail_servers": available_mail_servers,
        "available_groups": available_groups,
        "milter_enabled": milter_enabled,
        "milter_postfix_snippet": milter_postfix_snippet,
        "milter_postfix_reset_snippet": milter_postfix_reset_snippet,
        "discovered_rspamd_url": discovered_rspamd_url,
        "rspamd_url": rspamd_url,
        "rspamd_user": rspamd_user,
        "rspamd_password_set": rspamd_password_set,
        "rspamd_tls_verify": rspamd_tls_verify,
        "digest_enabled": digest_enabled,
        "digest_time": digest_time,
        "timezone": timezone_name,
        "admin_alert_email": admin_alert_email,
    }
    json.dump(result, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
