#!/usr/bin/env python3

"""Validate optional Traefik portal_hostname uniqueness and coupled mail_module_uuid availability."""

from __future__ import annotations

import json
import os
import sys

import agent


def _fail_validation(field: str, value: str, error_code: str) -> None:
    agent.set_status("validation-failed")
    json.dump(
        [
            {
                "field": field,
                "parameter": field,
                "value": value,
                "error": error_code,
            }
        ],
        sys.stdout,
    )
    sys.exit(2)


def main() -> int:
    data = json.load(sys.stdin)
    portal_enabled = bool(data.get("portal_enabled", True))
    portal_hostname = str(data.get("portal_hostname") or "").strip().lower()
    mail_module_uuid = str(data.get("mail_module_uuid") or "").strip()

    # Only validate Traefik route collisions when portal_enabled is True and a non-empty hostname is supplied
    if portal_enabled and portal_hostname:
        current_hostname = os.environ.get("PORTAL_HOSTNAME", "").strip().lower()
        if portal_hostname != current_hostname:
            if agent.http_route_in_use(domain=portal_hostname):
                _fail_validation(
                    "portal_hostname",
                    portal_hostname,
                    "hostname_already_in_use",
                )

    if not mail_module_uuid:
        _fail_validation("mail_module_uuid", mail_module_uuid, "mail_server_required")

    rdb = agent.redis_connect(use_replica=True)
    providers = agent.list_service_providers(
        rdb, "imap", "tcp", {"module_uuid": mail_module_uuid}
    )
    if not providers:
        _fail_validation("mail_module_uuid", mail_module_uuid, "mail_server_not_found")

    return 0


if __name__ == "__main__":
    sys.exit(main())
