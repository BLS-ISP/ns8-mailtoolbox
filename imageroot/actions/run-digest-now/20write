#!/usr/bin/env python3

"""Trigger Spam Quarantine Digest immediately via POST /api/internal/quarantine/run-digest."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


EMPTY_DIGEST_RESULT = {
    "users_checked": 0,
    "digests_sent": 0,
    "items_included": 0,
}


def main() -> int:
    payload: dict[str, str] = {"user": ""}
    try:
        raw = sys.stdin.read().strip()
        if raw:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                payload["user"] = str(parsed.get("user") or "").strip()
    except Exception:
        payload = {"user": ""}

    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not web_tcp_port or not token_path.is_file():
        json.dump(EMPTY_DIGEST_RESULT, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    if not token:
        json.dump(EMPTY_DIGEST_RESULT, sys.stdout)
        return 0

    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/quarantine/run-digest",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=180) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to run quarantine digest: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
