#!/usr/bin/env python3

"""Search Rspamd and cached SQLite mail history via POST /api/internal/mail-tracking/search."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


UNCONFIGURED_RESPONSE = {
    "rspamd_connected": False,
    "rspamd_error": "Module not configured",
    "total": 0,
    "entries": [],
}


def main() -> int:
    raw = sys.stdin.read().strip()
    payload = json.loads(raw) if raw else {}

    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    portal_hostname = os.environ.get("PORTAL_HOSTNAME", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not portal_hostname or not web_tcp_port or not token_path.is_file():
        json.dump(UNCONFIGURED_RESPONSE, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/mail-tracking/search",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to search mail history: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
