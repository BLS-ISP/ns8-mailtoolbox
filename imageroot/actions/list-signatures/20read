#!/usr/bin/env python3

"""Retrieve company signature rules and Before-DKIM Milter status via GET /api/internal/signatures."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


def _unconfigured_response() -> dict:
    try:
        host_port = int(os.environ.get("MILTER_TCP_PORT", "0") or 0)
    except ValueError:
        host_port = 0
    milter_raw = os.environ.get("MILTER_ENABLED", "1").strip().lower()
    milter_enabled = milter_raw not in ("0", "false", "no", "off")
    return {
        "signatures": [],
        "milter_status": {
            "enabled": milter_enabled,
            "listening": False,
            "port": 8090,
            "host_port": host_port,
            "messages_signed": 0,
            "messages_skipped": 0,
        },
    }


def main() -> int:
    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()

    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not web_tcp_port or not token_path.is_file():
        json.dump(_unconfigured_response(), sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/signatures",
        headers={
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            if isinstance(data, dict) and isinstance(data.get("milter_status"), dict):
                try:
                    host_port = int(os.environ.get("MILTER_TCP_PORT", "0") or 0)
                except ValueError:
                    host_port = 0
                if host_port and not data["milter_status"].get("host_port"):
                    data["milter_status"]["host_port"] = host_port
            json.dump(data, sys.stdout)
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to query signatures: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
