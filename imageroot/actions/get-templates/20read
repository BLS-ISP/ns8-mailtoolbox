#!/usr/bin/env python3

"""Retrieve company-wide vacation templates via GET /api/internal/templates."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


DEFAULT_FALLBACK_TEMPLATES = {
    "templates": [
        {
            "id": "default_de",
            "name": "Standard Abwesenheitsnotiz (DE)",
            "lang": "de",
            "is_default": True,
            "subject": "Abwesenheitsnotiz: {{displayName}}",
            "body": (
                "Guten Tag,\n\n"
                "vielen Dank für Ihre Nachricht. Ich bin derzeit nicht im Haus"
                "{{#endDate}} (voraussichtlich bis einschließlich {{endDate}}){{/endDate}} "
                "und habe keinen Zugriff auf meine E-Mails.\n"
                "{{#deputyEmail}}\nIn dringenden Fällen wenden Sie sich bitte an meine Vertretung unter {{deputyEmail}}.\n{{/deputyEmail}}\n"
                "Freundliche Grüße\n{{displayName}}"
            ),
        },
        {
            "id": "default_en",
            "name": "Default Out-of-Office Notice (EN)",
            "lang": "en",
            "is_default": False,
            "subject": "Out of Office: {{displayName}}",
            "body": (
                "Hello,\n\n"
                "Thank you for your email. I am currently out of the office"
                "{{#endDate}} (returning after {{endDate}}){{/endDate}} "
                "with limited access to my mailbox.\n"
                "{{#deputyEmail}}\nFor urgent matters, please contact {{deputyEmail}}.\n{{/deputyEmail}}\n"
                "Best regards,\n{{displayName}}"
            ),
        },
    ]
}


def main() -> int:
    mail_module_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()

    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    token_path = state_dir / "config" / "internal.token"

    if not mail_module_uuid or not web_tcp_port or not token_path.is_file():
        json.dump(DEFAULT_FALLBACK_TEMPLATES, sys.stdout)
        return 0

    token = token_path.read_text(encoding="utf-8").strip()
    req = urllib.request.Request(
        f"http://127.0.0.1:{web_tcp_port}/api/internal/templates",
        headers={
            "Accept": "application/json",
            "X-Internal-Token": token,
        },
        method="GET",
    )

    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            sys.stdout.write(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        err_body = exc.read().decode("utf-8", errors="replace")
        print(f"Backend HTTP {exc.code}: {err_body}", file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to retrieve templates from backend: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
