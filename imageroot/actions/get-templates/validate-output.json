{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get-templates output",
  "$id": "http://nethserver.org/json-schema/task/output/mail-toolbox/get-templates",
  "description": "Company-wide vacation auto-reply templates",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "templates"
  ],
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "lang",
          "subject",
          "body"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lang": { "type": "string" },
          "is_default": { "type": "boolean" },
          "subject": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
