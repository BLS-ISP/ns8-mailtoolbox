{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "list-connectors output",
  "$id": "http://nethserver.org/json-schema/task/output/mail-toolbox/list-connectors",
  "description": "External POP3/IMAP mail connectors and discovered NS8 IMAP-Sync (`ns8-imapsync`) bridge status",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "connectors"
  ],
  "properties": {
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "target_user",
          "target_email",
          "protocol",
          "host",
          "port",
          "use_ssl",
          "remote_user",
          "password_set",
          "interval_minutes",
          "leave_on_server",
          "enabled"
        ],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "target_user": { "type": "string" },
          "target_email": { "type": "string" },
          "protocol": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "use_ssl": { "type": "boolean" },
          "remote_user": { "type": "string" },
          "password_set": { "type": "boolean" },
          "interval_minutes": { "type": "integer" },
          "leave_on_server": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "last_sync_at": { "type": ["string", "null"] },
          "last_status": { "type": "string" },
          "last_error": { "type": "string" },
          "consecutive_failures": { "type": "integer" },
          "messages_fetched_total": { "type": "integer" }
        }
      }
    },
    "imapsync_bridge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "installed",
        "instances"
      ],
      "properties": {
        "installed": { "type": "boolean" },
        "updated_at": { "type": ["string", "null"] },
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "module_id",
              "ui_name",
              "node_id",
              "mail_server",
              "mail_host",
              "coupled",
              "tasks_loaded",
              "tasks"
            ],
            "properties": {
              "module_id": { "type": "string" },
              "ui_name": { "type": "string" },
              "node_id": { "type": "integer" },
              "mail_server": { "type": "string" },
              "mail_host": { "type": "string" },
              "coupled": { "type": "boolean" },
              "tasks_loaded": { "type": "boolean" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "task_id": { "type": "string" },
                    "localuser": { "type": "string" },
                    "name": { "type": "string" },
                    "remotehost": { "type": "string" },
                    "remoteport": { "type": "integer" },
                    "remoteuser": { "type": "string" },
                    "security": { "type": "string" },
                    "synchronization": { "type": "string" },
                    "service_running": { "type": "boolean" },
                    "sieve_enabled": { "type": "boolean" },
                    "delete_local": { "type": "boolean" },
                    "delete_remote": { "type": "boolean" },
                    "delete_remote_older": { "type": "integer" },
                    "last_sync_timestamp": { "type": ["integer", "null"] },
                    "last_sync_exit_code": { "type": ["integer", "null"] },
                    "has_log": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
