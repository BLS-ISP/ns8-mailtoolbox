#!/usr/bin/env python3

"""Deactivate active central vacation Sieve rules, stop services, delete Traefik route, and unbind user domains on module removal."""

from __future__ import annotations

import os
import subprocess
import sys
import urllib.request
from pathlib import Path

import agent
import agent.tasks


def main() -> int:
    # 1. Best-effort cleanup of active `toolbox-vacation` Sieve scripts & restoration of `sogo`
    #    BEFORE stopping mail-toolbox.service so user mailboxes are never left with orphaned rules.
    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    web_tcp_port = os.environ.get("WEB_TCP_PORT", "").strip()
    token_path = state_dir / "config" / "internal.token"
    if web_tcp_port and token_path.is_file():
        try:
            token = token_path.read_text(encoding="utf-8").strip()
            if token:
                req = urllib.request.Request(
                    f"http://127.0.0.1:{web_tcp_port}/api/internal/deactivate-all-vacations",
                    data=b"{}",
                    headers={
                        "Content-Type": "application/json",
                        "Accept": "application/json",
                        "X-Internal-Token": token,
                    },
                    method="POST",
                )
                with urllib.request.urlopen(req, timeout=15) as resp:
                    _ = resp.read()
        except Exception as exc:
            print(
                f"Warning: Best-effort Sieve cleanup on destroy-module skipped: {exc}",
                file=sys.stderr,
            )

    # 2. Disable and stop systemd user units
    subprocess.run(
        ["systemctl", "--user", "disable", "--now", "mail-toolbox-sync.timer"],
        check=False,
    )
    subprocess.run(
        ["systemctl", "--user", "disable", "--now", "mail-toolbox.service"],
        check=False,
    )

    # 3. Remove Traefik HTTP route
    module_id = os.environ.get("MODULE_ID", "").strip()
    traefik_id = agent.resolve_agent_id("traefik@node")
    if traefik_id and module_id:
        agent.tasks.run(
            agent_id=traefik_id,
            action="delete-route",
            data={"instance": module_id},
            extra={"isNotificationHidden": True},
        )

    # 4. Unbind user domains
    if hasattr(agent, "unbind_user_domains"):
        try:
            agent.unbind_user_domains()
        except Exception as exc:
            print(f"Warning: unbind_user_domains failed: {exc}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
