#!/bin/bash

#
# Restart NS8 Mail Toolbox services after module update so newly pulled
# runtime images (from org.nethserver.images) and updated timer schedules
# take effect cleanly, including Cockpit-only installations.
#

set -e

systemctl --user daemon-reload

if [[ -n "${MAIL_MODULE_UUID:-}" ]]; then
    /usr/local/bin/runagent discover-services || true
    /usr/local/bin/runagent sync-mailboxes-cache --min-age 300 --skip-imapsync || true
    systemctl --user enable --now mail-toolbox-sync.timer
    systemctl --user restart mail-toolbox-sync.timer
    systemctl --user try-restart mail-toolbox.service
fi
