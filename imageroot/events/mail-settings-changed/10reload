#!/usr/bin/env python3

"""Handle ns8-mail `mail-settings-changed` cluster events."""

import os
import subprocess
import sys
from pathlib import Path


def read_bytes_safe(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError:
        return b""


def main() -> None:
    # Consume optional event JSON payload from stdin without failing if empty
    try:
        _ = sys.stdin.read()
    except Exception:
        pass

    mail_uuid = os.environ.get("MAIL_MODULE_UUID", "").strip()
    if not mail_uuid:
        return

    state_dir = Path(os.environ.get("AGENT_STATE_DIR", ".")).resolve()
    mail_env_path = state_dir / "discovery_mail.env"
    before = read_bytes_safe(mail_env_path)

    subprocess.run(["discover-services"], check=False)
    subprocess.run(["sync-mailboxes-cache", "--skip-imapsync"], check=False)

    after = read_bytes_safe(mail_env_path)
    if after and after != before:
        subprocess.run(
            ["systemctl", "--user", "try-restart", "mail-toolbox.service"],
            check=False,
        )


if __name__ == "__main__":
    main()
